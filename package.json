{
  "name": "@emilo/requestify",
  "version": "1.0.0",
  "description": "",
  "main": "./dist/cjs/main.cjs",
  "types": "./dist/cjs/main.d.cts",
  "module": "./dist/esm/main.mjs",
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "attw": "attw .",
    "playground:install": "npm install --prefix playground",
    "playground:dev": "npm run dev --prefix playground",
    "dev": "concurrently \"npm run watch\" \"npm run playground:dev\""
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "default": "./dist/esm/main.mjs",
        "types": "./dist/esm/main.d.mts"
      },
      "require": {
        "default": "./dist/cjs/main.cjs",
        "types": "./dist/cjs/main.d.cts"
      }
    },
    "./package.json": "./package.json"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "cookie": "^2.0.1",
    "path-to-regexp": "^8.4.2",
    "qs": "^6.16.0",
    "url-join": "^5.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.6.1",
    "@types/qs": "^6.15.1",
    "concurrently": "^10.0.5",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "unrun": "^0.3.1"
  }
}
